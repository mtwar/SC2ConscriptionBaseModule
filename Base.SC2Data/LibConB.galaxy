void libConB_gf_RefreshActiveConscriptions () {
    // Variable Declarations
    string lv_conscription;

    // Automatic Variable Declarations
    int autoA213AAC8_ai;
    int autoA213AAC8_ae;

    // Variable Initialization

    // Implementation
    libConB_gf_ClearActiveConscriptions();
    autoA213AAC8_ai = 1;
    autoA213AAC8_ae = UserDataInstanceCount("Conscription")+1;
    while (autoA213AAC8_ai < autoA213AAC8_ae) {
        lv_conscription = UserDataInstance("Conscription", autoA213AAC8_ai);
        autoA213AAC8_ai = autoA213AAC8_ai+1;
        if (!libConB_gf_ConscriptionIsEnabled(lv_conscription)) {
