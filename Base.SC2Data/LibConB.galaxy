string libConB_gf_ExecuteConscriptionActionString (string lp_actionTypeName, string lp_unitTypeName, string lp_conscriptionStateName, string lp_sectionName) {
    // Variable Declarations
    int lv_actionType;
    string lv_unitType;
    int lv_state;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_state = libConB_ge_ConscriptionUnitState_Locked;

    // Implementation
    lv_actionType = libConB_gf_ParseConscriptionActionTypeString(lp_actionTypeName);
    if ((lv_actionType == libConB_ge_ConscriptionActionType_None)) {
        return "invalid action type name " + lp_actionTypeName;
    }

    if ((lv_actionType == libConB_ge_ConscriptionActionType_SaveAll)) {
        libConB_gf_SaveAllConscriptionsToCampaignBank(lp_sectionName);
        return "";
    }

    if ((lv_actionType == libConB_ge_ConscriptionActionType_LoadAll)) {
        return "not implemented";
    }

    lv_unitType = libConB_gf_ParseUnitTypeFromString(lp_unitTypeName);
    if ((lv_unitType == null)) {
        return "invalid unit type name " + lp_unitTypeName;
    }

    if ((lv_actionType != libConB_ge_ConscriptionActionType_Override)) {
        return libConB_gf_ExecuteConscriptionAction(lv_actionType, lv_unitType);
    }

    lv_state = libConB_gf_ParseConscriptionUnitStateString(lp_conscriptionStateName);
    if ((lv_state == libConB_ge_ConscriptionUnitState_None)) {
        return "invalid conscription unit state name " + lp_conscriptionStateName;
    }

    return libConB_gf_OverrideConscriptionState(lv_unitType, lv_state);
}

string libConB_gf_ExecuteConscriptionAction (int lp_actionType, string lp_unitType) {
    // Variable Declarations
    string lv_errorString;

    // Automatic Variable Declarations
    int autoC1FD8630_val;

    // Variable Initialization
    lv_errorString = "";

    // Implementation
    autoC1FD8630_val = lp_actionType;
    if (autoC1FD8630_val == libConB_ge_ConscriptionActionType_Unlock) {
        return libConB_gf_UnlockConscriptionUnit(lp_unitType);
    }
    else if (autoC1FD8630_val == libConB_ge_ConscriptionActionType_Lock) {
        return libConB_gf_LockConscriptionUnit(lp_unitType);
    }
    else if (autoC1FD8630_val == libConB_ge_ConscriptionActionType_Buy) {
        return libConB_gf_BuyConscriptionUnit(lp_unitType);
    }
    else if (autoC1FD8630_val == libConB_ge_ConscriptionActionType_Refund) {
        return libConB_gf_RefundConscriptionUnit(lp_unitType);
    }
    else {
        return "action type not implemented";
    }
}

