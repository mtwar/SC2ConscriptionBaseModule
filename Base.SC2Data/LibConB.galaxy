void libConB_gf_SaveAllConscriptionsToBank (bank lp_bank, string lp_section) {
    // Variable Declarations
    string lv_currentConscription;

    // Automatic Variable Declarations
    int auto55FF28C5_ai;
    int auto55FF28C5_ae;

    // Variable Initialization

    // Implementation
    BankLoad(BankName(lp_bank), 1);
    BankSectionRemove(lp_bank, lp_section);
    BankSectionCreate(lp_bank, lp_section);
    auto55FF28C5_ai = 1;
    auto55FF28C5_ae = UserDataInstanceCount("Conscription")+1;
    while (auto55FF28C5_ai < auto55FF28C5_ae) {
        lv_currentConscription = UserDataInstance("Conscription", auto55FF28C5_ai);
        auto55FF28C5_ai = auto55FF28C5_ai+1;
        if (!libConB_gf_ConscriptionIsEnabled(lv_currentConscription)) {
            continue;
        }
        libConB_gf_WriteConscriptionToBank(lp_bank, lp_section, lv_currentConscription);
    }
    BankSave(lp_bank);
}

void libConB_gf_LoadAllConscriptionsFromBank (bank lp_bank, string lp_section) {
    // Variable Declarations
    string lv_currentConscription;

    // Automatic Variable Declarations
    int auto70F7337B_ai;
    int auto70F7337B_ae;

    // Variable Initialization

    // Implementation
    auto70F7337B_ai = 1;
    auto70F7337B_ae = UserDataInstanceCount("Conscription")+1;
    while (auto70F7337B_ai < auto70F7337B_ae) {
        lv_currentConscription = UserDataInstance("Conscription", auto70F7337B_ai);
        auto70F7337B_ai = auto70F7337B_ai+1;
        if (!libConB_gf_ConscriptionIsEnabled(lv_currentConscription)) {
            continue;
        }
        libConB_gf_ReadConscriptionFromBank(lp_bank, lp_section, lv_currentConscription);
    }
}

void libConB_gf_WriteConscriptionToBank (bank lp_bank, string lp_section, string lp_conscription) {
    // Automatic Variable Declarations
    // Implementation
    libConB_gv_conscriptionBankData.lv_bank = lp_bank;
    libConB_gv_conscriptionBankData.lv_section = lp_section;
    libConB_gv_conscriptionBankData.lv_key = (lp_conscription);
    libConB_gv_conscriptionBankData.lv_state = UserDataGetInt("Conscription", lp_conscription, "State", 1);
    libNtve_gf_TriggerExecuteByName(UserDataGetString("ConscriptionModule", "Base", "Write Conscription To Bank Trigger", 1), true, true);
}

void libConB_gf_ReadConscriptionFromBank (bank lp_bank, string lp_section, string lp_conscription) {
    // Automatic Variable Declarations
    // Implementation
    libConB_gv_conscriptionBankData.lv_bank = lp_bank;
    libConB_gv_conscriptionBankData.lv_section = lp_section;
    libConB_gv_conscriptionBankData.lv_key = (lp_conscription);
    libConB_gv_conscriptionBankData.lv_state = 0;
    libNtve_gf_TriggerExecuteByName(UserDataGetString("ConscriptionModule", "Base", "Load Conscription From Bank Trigger", 1), true, true);
    libConB_gf_SetConscriptionState(lp_conscription, libConB_gf_ParseConscriptionUnitState(libConB_gv_conscriptionBankData.lv_state));
}

