string libConB_gf_GetConscriptionEntryForUnit (string lp_unitType) {
    // Variable Declarations
    string lv_currentConscription;
    bool lv_found;
    string lv_unitConscriptionData;

    // Automatic Variable Declarations
    int autoB62AEFA7_ai;
    int autoB62AEFA7_ae;

    // Variable Initialization

    // Implementation
    autoB62AEFA7_ai = 1;
    autoB62AEFA7_ae = UserDataInstanceCount("Conscription")+1;
    while (autoB62AEFA7_ai < autoB62AEFA7_ae) {
        lv_currentConscription = UserDataInstance("Conscription", autoB62AEFA7_ai);
        autoB62AEFA7_ai = autoB62AEFA7_ai+1;
        if (!libConB_gf_ConscriptionIsEnabled(lv_currentConscription)) {
            continue;
        }
        if ((libConB_gf_ParseUnitTypeFromString((lv_currentConscription)) == lp_unitType)) {
            return lv_currentConscription;
        }

    }
    TriggerDebugOutput(1, StringToText(("unit " + lp_unitType + " not found in the Conscription table")), true);
    return null;
}

