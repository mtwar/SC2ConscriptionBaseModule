// External Library Initialization
void libConB_InitLibraries () {
    libNtve_InitVariables();
}

// Variable Initialization
bool libConB_InitVariables_completed = false;

void libConB_InitVariables () {
    int init_i;

    if (libConB_InitVariables_completed) {
        return;
    }

    libConB_InitVariables_completed = true;

    libConB_gv_conscriptionBankData.lv_section = "";
    libConB_gv_conscriptionBankData.lv_key = "";
    libConB_gv_conscriptionBankSectionName = "";
    for (init_i = 0; init_i <= 256; init_i += 1) {
        libConB_gv_activeConscriptions[init_i].lv_id = "";
        libConB_gv_activeConscriptions[init_i].lv_state = libConB_ge_ConscriptionUnitState_None;
        libConB_gv_activeConscriptions[init_i].lv_unlockTriggerName = "";
    }
}

// Presets
string libConB_ge_ConscriptionActionType_Ident (int lp_val) {
         if (lp_val == libConB_ge_ConscriptionActionType_None) { return "None"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Unlock) { return "Unlock"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Lock) { return "Lock"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Buy) { return "Buy"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Refund) { return "Refund"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Override) { return "Override"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Save) { return "Save"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_Load) { return "Load"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_SaveAll) { return "SaveAll"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_LoadAll) { return "LoadAll"; }
    else if (lp_val == libConB_ge_ConscriptionActionType_ToggleDebug) { return "ToggleDebug"; }
    return null;
}

string libConB_ge_ConscriptionUnitState_Ident (int lp_val) {
         if (lp_val == libConB_ge_ConscriptionUnitState_Locked) { return "Locked"; }
    else if (lp_val == libConB_ge_ConscriptionUnitState_Available) { return "Available"; }
    else if (lp_val == libConB_ge_ConscriptionUnitState_Purchased) { return "Purchased"; }
    else if (lp_val == libConB_ge_ConscriptionUnitState_None) { return "None"; }
    return null;
}

// Functions
int libConB_gf_ParseConscriptionActionTypeString (string lp_actionTypeName) {
    // Automatic Variable Declarations
    string auto578113FE_val;

    // Implementation
    auto578113FE_val = StringCase(lp_actionTypeName, false);
    if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_Unlock), false)) {
        return libConB_ge_ConscriptionActionType_Unlock;
    }
    else if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_Lock), false)) {
        return libConB_ge_ConscriptionActionType_Lock;
    }
    else if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_Buy), false)) {
        return libConB_ge_ConscriptionActionType_Buy;
    }
    else if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_Refund), false)) {
        return libConB_ge_ConscriptionActionType_Refund;
    }
    else if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_Override), false)) {
        return libConB_ge_ConscriptionActionType_Override;
    }
    else if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_SaveAll), false)) {
        return libConB_ge_ConscriptionActionType_SaveAll;
    }
    else if (auto578113FE_val == StringCase(libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_LoadAll), false)) {
        return libConB_ge_ConscriptionActionType_LoadAll;
    }
    else {
        return libConB_ge_ConscriptionActionType_None;
    }
}

int libConB_gf_GetAvailableCredits () {
    // Automatic Variable Declarations
    // Implementation
    libConB_gv_creditsAvailable = 0;
    libNtve_gf_TriggerExecuteByName(UserDataGetString("ConscriptionModule", "Base", "Get Available Credits Trigger", 1), true, true);
    return libConB_gv_creditsAvailable;
}

string libConB_gf_UnlockConscription (string lp_conscription) {
    // Variable Declarations
    int lv_currentState;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_currentState = libConB_gf_ParseConscriptionUnitState(UserDataGetInt("Conscription", lp_conscription, "State", 1));

    // Implementation
    if ((lv_currentState != libConB_ge_ConscriptionUnitState_Locked)) {
        return ("unit type " + lp_conscription + " already set to " + libConB_ge_ConscriptionUnitState_Ident(lv_currentState));
    }

    libConB_gf_SetConscriptionState(lp_conscription, libConB_ge_ConscriptionUnitState_Available);
    if ((UserDataGetInt("Conscription", lp_conscription, "Price", 1) == 0)) {
        return libConB_gf_BuyConscription(lp_conscription);
    }
    else {
        libConB_gf_ApplyConscriptionToTechTree(lp_conscription);
    }
    return "";
}

string libConB_gf_LockConscription (string lp_conscription) {
    // Variable Declarations
    int lv_currentState;
    string lv_errorString;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_currentState = libConB_gf_ParseConscriptionUnitState(UserDataGetInt("Conscription", lp_conscription, "State", 1));
    lv_errorString = "";

    // Implementation
    if ((lv_currentState == libConB_ge_ConscriptionUnitState_Purchased)) {
        lv_errorString = libConB_gf_RefundConscription(lp_conscription);
        if ((StringEqual(lv_errorString, "", c_stringNoCase) == false)) {
            return lv_errorString;
        }

    }

    libConB_gf_SetConscriptionState(lp_conscription, libConB_ge_ConscriptionUnitState_Locked);
    libConB_gf_ApplyConscriptionToTechTree(lp_conscription);
    return "";
}

string libConB_gf_BuyConscription (string lp_conscription) {
    // Variable Declarations
    int lv_currentState;
    string lv_errorString;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_currentState = libConB_gf_ParseConscriptionUnitState(UserDataGetInt("Conscription", lp_conscription, "State", 1));
    lv_errorString = "";

    // Implementation
    if ((lv_currentState == libConB_ge_ConscriptionUnitState_Purchased)) {
        return "unit type " + lp_conscription + " already set to " + libConB_ge_ConscriptionUnitState_Ident(lv_currentState);
    }

    if ((lv_currentState == libConB_ge_ConscriptionUnitState_Locked)) {
        return "unit type " + lp_conscription + " is " + libConB_ge_ConscriptionUnitState_Ident(lv_currentState);
    }

    if ((libConB_gf_GetAvailableCredits() < UserDataGetInt("Conscription", lp_conscription, "Price", 1))) {
        return "insufficient credits (" + IntToString(libConB_gf_GetAvailableCredits()) + ") to buy " + lp_conscription + "(" + IntToString(UserDataGetInt("Conscription", lp_conscription, "Price", 1)) + ")";
    }

    libConB_gf_SetConscriptionState(lp_conscription, libConB_ge_ConscriptionUnitState_Purchased);
    libConB_gf_ApplyConscriptionToTechTree(lp_conscription);
    return "";
}

string libConB_gf_RefundConscription (string lp_conscription) {
    // Variable Declarations
    int lv_currentState;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_currentState = libConB_gf_ParseConscriptionUnitState(UserDataGetInt("Conscription", lp_conscription, "State", 1));

    // Implementation
    if ((lv_currentState != libConB_ge_ConscriptionUnitState_Purchased)) {
        return ("unit type " + lp_conscription + " already set to " + libConB_ge_ConscriptionUnitState_Ident(lv_currentState));
    }

    libConB_gf_SetConscriptionState(lp_conscription, libConB_ge_ConscriptionUnitState_Available);
    libConB_gf_ApplyConscriptionToTechTree(lp_conscription);
    return "";
}

string libConB_gf_OverrideConscriptionState (string lp_unitType, int lp_state) {
    // Variable Declarations
    string lv_conscription;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_conscription = libConB_gf_GetConscriptionEntryForUnit(lp_unitType);

    // Implementation
    if (!libConB_gf_NullOrEmptyString(lv_conscription)) {
        libConB_gf_SetConscriptionState(lv_conscription, lp_state);
        libConB_gf_ApplyConscriptionToTechTree(lv_conscription);
        return "";
    }
    return ("conscription not configured for unit type " + lp_unitType);
}

bool libConB_gf_ConscriptionPurchased (string lp_conscription) {
    // Automatic Variable Declarations
    // Implementation
    return (UserDataGetInt("Conscription", lp_conscription, "State", 1) == libConB_ge_ConscriptionUnitState_Purchased);
}

