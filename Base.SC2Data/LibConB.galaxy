string libConB_gf_CamelCaseFromSpaceSeparated (string lp_inputWords, bool lp_capitalize, int lp_startTokenIndex, int lp_maxTokens) {
    // Variable Declarations
    string lv_camelCasedWords;
    string lv_currentToken;
    int lv_currentTokenIndex;
    int lv_numberOfTokens;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_camelCasedWords = "";
    lv_currentToken = "";

    // Implementation
    lv_currentTokenIndex = lp_startTokenIndex;
    lv_currentToken = StringWord(lp_inputWords, lv_currentTokenIndex);
    while ((lv_currentToken != null) && ((lp_maxTokens <= 0) || (lv_numberOfTokens < lp_maxTokens))) {
        lv_numberOfTokens = (lv_numberOfTokens + 1);
        lv_currentToken = StringCase(lv_currentToken, false);
        lv_currentToken = (StringCase(StringSub(lv_currentToken, 1, 1), true) + StringSub(lv_currentToken, 2, StringLength(lv_currentToken)));
        lv_camelCasedWords = (lv_camelCasedWords + lv_currentToken);
        lv_currentTokenIndex = (lv_currentTokenIndex + 1);
        lv_currentToken = StringWord(EventChatMessage(false), lv_currentTokenIndex);
    }
    if ((lp_capitalize == false)) {
        lv_camelCasedWords = (StringCase(StringSub(lv_camelCasedWords, 1, 1), false) + StringSub(lv_camelCasedWords, 2, StringLength(lv_camelCasedWords)));
    }

    return lv_camelCasedWords;
}

