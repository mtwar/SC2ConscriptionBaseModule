string libConB_gf_ConscriptionCheatHandler (string lp_inputWords) {
    // Variable Declarations
    string lv_actionTypeName;
    string lv_unitTypeName;
    int lv_unitTypeNameIndex;
    string lv_stateName;
    string lv_sectionName;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_actionTypeName = "";
    lv_unitTypeName = "";
    lv_unitTypeNameIndex = (libConB_ge_ConscriptionCheatToken_UnitTokenStartIndex);
    lv_stateName = "";
    lv_sectionName = "";

    // Implementation
    lv_actionTypeName = StringWord(lp_inputWords, (libConB_ge_ConscriptionCheatToken_ActionTokenIndex));
    if ((libConB_gf_NullOrEmptyString(lv_actionTypeName) == true)) {
        return ("Action type name required.<n/>Format: conscription <action type name> <unit type name><n/>Valid actions: " + libConB_gf_ValidConscriptionActionList());
    }

    if ((StringEqual(lv_actionTypeName, libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_ToggleDebug), c_stringNoCase) == true)) {
        libConB_gf_ToggleDebug();
        return "";
    }

    if (((StringEqual(lv_actionTypeName, libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_SaveAll), c_stringNoCase) == true) || (StringEqual(lv_actionTypeName, libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_LoadAll), c_stringNoCase) == true))) {
        if ((libConB_gf_IsStoryMap(libConB_gf_GetCurrentMap()) == true)) {
            lv_sectionName = libConB_gf_GetBankSectionName(null);
        }
        else {
            lv_sectionName = libConB_gf_GetBankSectionName(libConB_gf_GetCurrentMap());
        }
        return libConB_gf_ExecuteConscriptionActionString(lv_actionTypeName, lv_unitTypeName, lv_stateName, lv_sectionName);
    }

    if ((StringEqual(lv_actionTypeName, libConB_ge_ConscriptionActionType_Ident(libConB_ge_ConscriptionActionType_Override), c_stringNoCase) == true)) {
        lv_stateName = StringWord(lp_inputWords, lv_unitTypeNameIndex);
        if ((StringEqual(lv_stateName, "", c_stringNoCase) == true)) {
            return "Conscription State name required.<n/>Format: conscription override <state name> <unit type name><n/>";
        }

        lv_unitTypeNameIndex = (lv_unitTypeNameIndex + 1);
    }

    lv_unitTypeName = libConB_gf_CamelCaseFromSpaceSeparated(lp_inputWords, true, lv_unitTypeNameIndex, 0);
    if ((StringEqual(lv_unitTypeName, "", c_stringNoCase) == true)) {
        return ("Unit type name required.<n/>Format: conscription <action type name> <unit type name><n/>Valid actions: " + libConB_gf_ValidConscriptionActionList());
    }

    return libConB_gf_ExecuteConscriptionActionString(lv_actionTypeName, lv_unitTypeName, lv_stateName, lv_sectionName);
}

string libConB_gf_ValidConscriptionActionList () {
    // Variable Declarations
    int lv_actionIndex;
    string lv_actionString;
    string lv_outputString;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_actionIndex = libConB_ge_ConscriptionActionType_Unlock;
    lv_actionString = libConB_ge_ConscriptionActionType_Ident(lv_actionIndex);
    lv_outputString = "";

    // Implementation
    if ((lv_actionString == null)) {
        return "";
    }

    while ((lv_actionString != null)) {
        lv_actionIndex = lv_actionIndex + 1;
        lv_outputString = lv_outputString + ", " + lv_actionString;
        lv_actionString = libConB_ge_ConscriptionActionType_Ident(lv_actionIndex);
    }
    return StringSub(lv_outputString, 3, StringLength(lv_outputString));
}

